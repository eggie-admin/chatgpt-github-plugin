{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eggiebagelface.art/schemas/lum-scene-forge-wizard-state.json",
  "title": "Lum Scene Forge Wizard State",
  "type": "object",
  "additionalProperties": false,
  "required": ["scene", "actors", "dialogue", "emoji_mode", "status"],
  "properties": {
    "scene": {
      "type": "string",
      "minLength": 1
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["lum", "eggie", "cutie"]
      }
    },
    "dialogue": {
      "type": "string",
      "minLength": 1
    },
    "emoji_mode": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "enum": ["collecting", "ready", "generated", "quit"]
    }
  }
}
